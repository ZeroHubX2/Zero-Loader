    local mark = label({ Text = "!", FontFace = font(W_BOLD), TextSize = 12, TextColor3 = C.Bg, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Visible = false, Parent = fill })
    local name = label({ Text = title, TextSize = 14, TextColor3 = C.Dim, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(0.6, -28, 1, 0), Parent = row })
    local detail = label({ Text = "", FontFace = MONO, TextSize = 11, TextColor3 = C.Dim, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.5, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
    local s = setmetatable({ title = title, rs = rs, arc = arc, fill = fill, tick = tick, mark = mark, name = name, detail = detail, row = row }, Step)
    table.insert(stepList, s)
    return s
end
function Step:_spin(on)
    self.arc.Enabled = on
    spinners[self.arc] = on or nil
end
function Step:Reset()
    self:_spin(false)
    self.rs.Color, self.rs.Transparency = C.Stroke, 0
    self.fill.Size = UDim2.fromOffset(0, 0)
    self.tick.Visible, self.mark.Visible = false, false
    self.name.TextColor3, self.detail.TextColor3 = C.Dim, C.Dim
    self.name.FontFace = font()
    self.detail.Text = ""
end
function Step:Run(detail)
    self:_spin(true)
    tween(self.rs, 0.2, { Color = C.Accent })
    tween(self.name, 0.2, { TextColor3 = C.Text })
    self.name.FontFace = font(W_MED)
    self.detail.Text = detail or ""
    tween(self.detail, 0.2, { TextColor3 = C.Sub })
end
function Step:_finish(col, detail, icon)
    self:_spin(false)
    tween(self.rs, 0.2, { Color = col, Transparency = 1 })
    self.fill.BackgroundColor3 = col
    self.tick.Visible = icon == "tick"
    self.mark.Visible = icon == "mark"
    tween(self.fill, 0.35, { Size = UDim2.fromOffset(16, 16) }, Enum.EasingStyle.Back)
    self.name.FontFace = font()
    tween(self.name, 0.25, { TextColor3 = icon == "tick" and C.Sub or col })
    if detail then self.detail.Text = detail end
    tween(self.detail, 0.25, { TextColor3 = icon == "tick" and C.Dim or col })
end
function Step:Done(detail) self:_finish(C.Accent, detail, "tick") end
function Step:Warn(detail) self:_finish(C.Warn, detail, "mark") end
function Step:Fail(detail) self:_finish(C.Bad, detail, "mark") end

