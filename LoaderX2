local function new(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    if parent then o.Parent = parent end
    return o
end
local function corner(r) return new("UICorner", { CornerRadius = r and UDim.new(0, r) or UDim.new(1, 0) }) end
local function stroke(col, t, tr)
    return new("UIStroke", { Color = col or C.Stroke, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function label(props)
    local l = new("TextLabel", {
        BackgroundTransparency = 1, TextColor3 = C.Text, FontFace = font(), TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, Text = "",
    })
    local parent = props.Parent
    for k, v in pairs(props) do
        if k ~= "Parent" then l[k] = v end
    end
    if parent then l.Parent = parent end
    return l
end
local function fade(seq)
    local kps = {}
    for _, p in ipairs(seq) do table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2])) end
    return NumberSequence.new(kps)
end

