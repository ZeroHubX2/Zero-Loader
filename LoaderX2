local function pace(since, min)
    local left = (DEMO and 1.2 or min or 0.28) - (os.clock() - since)
    if left > 0 then task.wait(left) end
end

local run
run = function()
    hideActions()
    for _, s in ipairs(stepList) do s:Reset() end
    barColor.Color = ColorSequence.new(C.Accent, ACCENT_HI)
    setProgress(0)
    local total = #stepList + 1

    local at = os.clock()
    sExec:Run()
    setStatus("Checking executor capabilities…")
    local execName = "Unknown"
    pcall(function()
        if identifyexecutor then
            local n, v = identifyexecutor()
            execName = tostring(n) .. (v and (" " .. tostring(v)) or "")
        end
    end)
    execLbl.Text = execName
    local hasLoad = type(loadstring) == "function"
    local hasHttp = pcall(function() return game.HttpGet end)
    pace(at)
    if not alive then return end
    if not (hasLoad and hasHttp) then
        sExec:Fail(not hasLoad and "loadstring missing" or "HttpGet missing")
        setProgress(1 / total, C.Bad)
        setStatus("Your executor can't run this loader.", C.Bad)
        showActions("Close", outro, "Retry", run)
        return
    end
    sExec:Done(execName)
    setProgress(1 / total)

    at = os.clock()
    sReady:Run()
    setStatus("Waiting for the game to finish loading…")
    if not game:IsLoaded() then game.Loaded:Wait() end
    local waitChar = os.clock()
    while alive and not LocalPlayer.Character and os.clock() - waitChar < 10 do task.wait(0.1) end
    local char = LocalPlayer.Character
    if char then pcall(function() char:WaitForChild("HumanoidRootPart", 10) end) end
    pace(at)
    if not alive then return end
    sReady:Done("ready")
    setProgress(2 / total)

    at = os.clock()
    sGame:Run(tostring(game.GameId))
    setStatus("Matching this game against the supported list…")
    local info = GAMES[game.GameId]
    if DEMO == "unsupported" then
        info = nil
    elseif DEMO and not info then
        info = GAMES[next(GAMES)]
    end
    local placeName
    task.spawn(function()
        local ok, pi = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if ok and type(pi) == "table" then placeName = pi.Name end
    end)
    pace(at, 0.4)
    if not alive then return end
    if not info then
        gameName.Text = placeName or "Unsupported game"
        gameName.TextColor3 = C.Bad
        sGame:Fail("not supported")
        setProgress(3 / total, C.Bad)
        local names = {}
        for _, g in pairs(GAMES) do table.insert(names, g.Name) end
        table.sort(names)
        setStatus("Supported: " .. table.concat(names, ", "), C.Bad)
        showActions("Close", outro, "Copy Game ID", function()
            if setclipboard then
                pcall(setclipboard, tostring(game.GameId))
                setStatus("Game ID copied to clipboard.", C.Good)
            else
                setStatus("Clipboard isn't available. Game ID: " .. tostring(game.GameId), C.Warn)
            end
        end)
        return
    end
    gameName.Text = info.Name
    gameName.TextColor3 = C.Text
    sGame:Done(info.Name)
    setProgress(3 / total)

    at = os.clock()
    sPlace:Run(tostring(game.PlaceId))
    setStatus("Verifying the current place…")
    local waited = os.clock()
    while not placeName and os.clock() - waited < 1.5 do task.wait(0.05) end
    pace(at)
    if not alive then return end
    if game.PlaceId == 0 then
        sPlace:Warn("studio / local")
    else
        sPlace:Done(tostring(game.PlaceId))
    end
    gameIdLbl.Text = tostring(game.GameId)
    setProgress(4 / total)

    at = os.clock()
    sFetch:Run()
    local src, err
    for attempt = 1, 3 do
        setStatus(attempt == 1 and "Downloading the latest build…" or ("Retrying download (" .. attempt .. "/3)…"))
        local ok, res
        if DEMO then
            task.wait(0.6)
            ok, res = DEMO ~= "error", DEMO == "error" and "HTTP 404 Not Found (demo)" or string.rep(" ", 641269)
        else
            ok, res = pcall(function() return game:HttpGet(info.Url) end)
        end
        if ok and type(res) == "string" and #res > 0 and not res:find("^404") then
            src = res
            break
        end
        err = ok and "empty response" or tostring(res)
        if attempt < 3 then task.wait(1) end
    end
    pace(at)
    if not alive then return end
    if not src then
        sFetch:Fail("failed")
        setProgress(5 / total, C.Bad)
        setStatus("Download failed: " .. tostring(err), C.Bad)
        showActions("Close", outro, "Retry", run)
        return
    end
    sFetch:Done(string.format("%.1f KB", #src / 1024))
    setProgress(5 / total)

    at = os.clock()
    sBuild:Run()
    setStatus("Compiling script…")
    local fn, cerr
    if DEMO then
        fn = function() end
    else
        fn, cerr = loadstring(src)
    end
    pace(at)
    if not alive then return end
    if not fn then
        sBuild:Fail("error")
        setProgress(6 / total, C.Bad)
        setStatus("Compile error: " .. tostring(cerr), C.Bad)
        showActions("Close", outro, "Retry", run)
        return
    end
    sBuild:Done("ok")
    setProgress(1, C.Good)
    setStatus("Launching " .. info.Name .. "…", C.Good)
    task.wait(DEMO and 1.2 or 0.55)
    if not alive then return end
    if DEMO then
        setStatus("Demo complete · nothing was launched", C.Good)
        showActions("Close", outro, "Replay", run)
        return
    end
    outro(function()
        task.spawn(function()
            local ok, e = pcall(fn)
            if not ok then warn("[Zero Hub] " .. tostring(e)) end
        end)
    end)
end

intro()
task.delay(0.35, function()
    if alive then run() end
end)
